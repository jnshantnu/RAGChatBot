# Postgres connection for the local install created during setup (Phase 0)
DATABASE_URL=postgresql://ragapp:ragapp_dev_pw@127.0.0.1:5432/ragchatbot

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model slugs (https://openrouter.ai/models) -- swap freely
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Native output is 4096-dim (Matryoshka-trained, truncatable 32-4096), but
# pgvector's HNSW index caps at 2000 dims for the standard vector type -- 1536
# keeps it indexable. See ingest/embed.py.
OPENROUTER_EMBEDDING_DIM=1536
# Qwen3-Embedding models want an instruction prefix on the query side (not the
# document side) for best retrieval quality -- see ingest/embed.py:embed_query
OPENROUTER_EMBEDDING_QUERY_INSTRUCTION=Given a partner-support question, retrieve relevant policy, API, and order documentation.
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
